{
  "name": "@gdansk/widget",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mplemay/gdansk",
    "directory": "packages/widget"
  },
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "gdansk-widget": "dist/cli.js"
  },
  "files": [
    "dist",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./dist/client.js"
    },
    "./runtime": {
      "types": "./types/runtime-entry.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "vite build && node ./node_modules/typescript/bin/tsc",
    "clean": "rm -rf dist types",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "peerDependencies": {
    "vite": ">=8.1 <9"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
